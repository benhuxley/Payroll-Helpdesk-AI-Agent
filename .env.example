# Copy the variables you need into your shell or a local .env (never commit real values).

# Required for the agent and the evals. Set it in your own environment.
ANTHROPIC_API_KEY=

# Which agent version to run (a file in configs/). Default: configs/agent_v2.yaml
AGENT_CONFIG=configs/agent_v2.yaml

# Mock WFM API (started automatically by `helpdesk-demo`)
WFM_BASE_URL=http://127.0.0.1:8001
WFM_API_KEY=dev-wfm-key

# Ticketing: "mock" (local Zendesk-compatible endpoint) or "zendesk" (your real trial)
TICKETING_BACKEND=mock
# Only needed when TICKETING_BACKEND=zendesk
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
